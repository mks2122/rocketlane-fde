# Copy to .env and fill in. Never commit .env.

ENV=dev                         # dev | test | prod
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=sqlite+aiosqlite:///./data/novacrm.db

# Required. Protects /deals and /admin endpoints (X-Admin-Token header). 16+ chars.
ADMIN_TOKEN=

# --- OpenAI (Agents SDK) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TRACE_INCLUDE_SENSITIVE_DATA=true   # false in prod (keeps PII out of traces)

# --- Gmail ---
GMAIL_ENABLED=false                 # true once scripts/gmail_auth.py has written the token
GMAIL_CREDENTIALS_PATH=secrets/credentials.json
GMAIL_TOKEN_PATH=secrets/token.json
GMAIL_POLL_SECONDS=30
GMAIL_MAX_POLL_BACKOFF_SECONDS=300
GMAIL_PROCESSED_LABEL=novacrm-processed
GMAIL_LOOKBACK_DAYS=7               # ignore older mail when connecting an existing inbox
GMAIL_MAX_BODY_CHARS=50000
# Sender allowlist (fail closed: with both empty nothing is processed, and polling refuses to start)
ALLOWED_SENDER_DOMAINS=[]           # JSON list, e.g. ["novacrm-demo.com"]
ALLOWED_SENDER_EMAILS=[]            # JSON list, e.g. ["your.personal@gmail.com"]

# --- Vapi ---
VAPI_API_KEY=                       # Vapi dashboard > API Keys > private key
VAPI_BASE_URL=https://api.vapi.ai
VAPI_ASSISTANT_NAME=NovaCRM tier confirmation
VAPI_MODEL=gpt-4.1-mini             # LLM the voice assistant runs on (billed by Vapi, not OpenAI)
VAPI_ASSISTANT_ID=                  # printed by scripts/setup_vapi_assistant.py
VAPI_PHONE_NUMBER_ID=               # printed by scripts/setup_vapi_assistant.py
# Shared secret Vapi sends as x-vapi-secret on every webhook. 32+ random chars:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_WEBHOOK_SECRET=
PUBLIC_BASE_URL=                    # ngrok https URL, e.g. https://your-name.ngrok-free.app

# --- Twilio (number imported into Vapi; calls are placed by Vapi) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                # E.164, e.g. +13165550100

# --- Call policy ---
CALL_MAX_ATTEMPTS=3
CALL_RETRY_DELAYS_SECONDS=[600,1800]   # demo: [60,60]
CALL_WINDOW_START=09:00
CALL_WINDOW_END=19:00
CALL_TIMEZONE=Asia/Kolkata
CALL_DAYS=[0,1,2,3,4]               # Mon=0 .. Sun=6; demo on a weekend: [0,1,2,3,4,5,6]
CALL_MAX_DURATION_SECONDS=240

# --- Rocketlane ---
ROCKETLANE_API_KEY=
ROCKETLANE_BASE_URL=https://api.rocketlane.com/api/1.0

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_ESCALATION_CHANNEL=cs-escalations

# --- Escalation ---
ESCALATION_EMAIL=

# --- HTTP ---
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_BASE_SECONDS=1
HTTP_BACKOFF_MAX_SECONDS=8
HTTP_MAX_CONCURRENCY=4
